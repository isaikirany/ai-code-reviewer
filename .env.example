# Copy to .env only if you do not already have one. Never commit real values.
OPENAI_API_KEY=replace_with_your_openai_api_key
GITHUB_TOKEN=replace_with_your_github_personal_access_token
SUPABASE_URL=https://your-project.supabase.co
# Operator-owned backend secret; never distribute this key to users.
SUPABASE_KEY=replace_with_your_supabase_secret_key
